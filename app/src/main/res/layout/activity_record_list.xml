<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/runner_records_root"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="11dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:layout_marginBottom="19dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:id="@+id/runner_records_brand" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:includeFontPadding="false"
                    android:text="运动助手" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@id/tv_title" android:layout_width="match_parent" android:includeFontPadding="false"
                    android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="跑步记录"
                    android:letterSpacing="-0.035" android:textSize="29sp" android:textStyle="bold" />
            </LinearLayout>
            <com.dudu.run.ui.MaterialButtonView android:id="@+id/runner_records_avatar" android:layout_width="44dp" android:layout_height="44dp"
                android:src="@drawable/ic_demo_user_round" android:contentDescription="打开我的"  style="@style/Widget.Material3Expressive.Button.IconButton.Tonal" app:iconGravity="textStart" app:iconPadding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
        </LinearLayout>
        <com.dudu.legacy.androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@id/srl_refresh"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <com.dudu.legacy.androidx.recyclerview.widget.RecyclerView android:id="@id/rcv_list"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:paddingBottom="86dp" android:clipToPadding="false" />
        </com.dudu.legacy.androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
    <include layout="@layout/runner_dock" />
</FrameLayout>
