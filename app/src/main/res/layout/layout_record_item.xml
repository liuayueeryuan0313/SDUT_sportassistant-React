<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingBottom="3dp">
    <LinearLayout android:id="@+id/runner_record_card" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="68dp" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="9dp" android:paddingBottom="9dp">
        <ImageView android:id="@+id/runner_record_icon" android:layout_width="39dp" android:layout_height="39dp"
            android:padding="10dp" android:layout_marginEnd="11dp" android:importantForAccessibility="no"
            android:src="@drawable/ic_demo_footprints" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@id/tv_item_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:includeFontPadding="false" android:textSize="14sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp">
                <TextView android:id="@id/tv_item_distance" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:includeFontPadding="false" android:textSize="12sp" />
                <TextView android:id="@id/tv_item_speed" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:includeFontPadding="false" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/runner_record_chevron" android:layout_width="19dp" android:layout_height="19dp"
            android:src="@drawable/ic_demo_chevron_right" android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
