<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:background="@color/white" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:background="@color/white" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <TextView android:textSize="@dimen/textsize_20" android:textStyle="bold" android:textColor="@color/text_color_black" android:gravity="center|left" android:paddingLeft="20.0dip" android:layout_width="fill_parent" android:layout_height="@dimen/title_height" android:text="规则" />
    </LinearLayout>
    <FrameLayout android:layout_width="fill_parent" android:layout_height="fill_parent">
        <WebView android:id="@id/webview" android:layout_width="fill_parent" android:layout_height="fill_parent" />
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@id/layout_error" android:background="@color/white" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent">
            <TextView android:id="@id/tv_error" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="加载失败，点击重试" />
        </LinearLayout>
    </FrameLayout>
